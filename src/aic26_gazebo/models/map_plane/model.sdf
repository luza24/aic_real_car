<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="map_plane">
    <static>true</static>
    <link name="link">

      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>4.2 4.2</size>
          </plane>
        </geometry>
        <material>
          <script>
            <uri>model://map_plane/materials/scripts</uri>
            <uri>model://map_plane/materials/textures</uri>
            <name>map/material</name>
          </script>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>4.2 4.2</size>
          </plane>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>