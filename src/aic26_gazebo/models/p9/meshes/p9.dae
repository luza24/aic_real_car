  <library_effects>
    <effect id="p-effect">
      <profile_COMMON>
        <newparam sid="p9_jpg-surface">
          <surface type="2D">
            <init_from>p9_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="p9_jpg-sampler">
          <sampler2D>
            <source>p9_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="p9_jpg-sampler" texcoord="UV贴图"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
    <image id="p9_jpg" name="p9_jpg">
      <init_from>p9.jpg</init_from>
    </image>
  </library_images>
  <library_materials>
    <material id="p-material" name="p">
      <instance_effect url="#p-effect"/>
    </material>
  </library_materials>
