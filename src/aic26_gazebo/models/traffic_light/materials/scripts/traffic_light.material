material traffic_light/red_on
{
    technique
    {
        pass
        {
            ambient 1.0 1.0 1.0 1.0
            diffuse 1.0 1.0 1.0 1.0
            emissive 0.6 0.0 0.0 1.0
            scene_blend alpha_blend
            depth_write off
            texture_unit
            {
                texture red_on.png
            }
        }
    }
}

