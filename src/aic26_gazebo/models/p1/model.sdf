<?xml version="1.0"?>
<sdf version="1.6">
  <model name="p1">
    <static>true</static>
    <link name="board">

      <collision name="collision">
        <pose>0 0 0.1</pose>
        <geometry>
          <box><size>0.01 0.09 0.2</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://p1/meshes/p1.dae</uri>
          </mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>
