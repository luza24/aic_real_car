<?xml version="1.0"?>
<launch>

  <arg name="day_night" default="day"/>
  <arg name="sky_time"  default=""/>
  <arg name="show_view" default="true"/>
  <arg name="view_width" default="640"/>
  <arg name="view_height" default="360"/>
  <!-- This machine has no usable GPU (N100 on kernel 5.15), so gazebo renders
       the camera sensor with llvmpipe on the CPU. 1280x720@30 saturates
       almost two cores; the sim defaults to a smaller image. capture.launch
       raises them back to the full dataset resolution. -->
  <arg name="camera_image_width"  default="640"/>
  <arg name="camera_image_height" default="360"/>
  <arg name="camera_image_rate"   default="15.0"/>
  <!-- The day/night node still applies the sky; its Tk slider is off by
       default so the sim only transfers Gazebo and RViz. -->
  <arg name="day_night_gui" default="false"/>
  <arg name="day_night_gui_delay" default="12.0"/>

  <env name="GAZEBO_PLUGIN_PATH"
       value="$(find aic26_gazebo)/../../devel/lib:$(optenv GAZEBO_PLUGIN_PATH)"/>
  <env name="GAZEBO_MODEL_PATH"
       value="$(find aic26_gazebo)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(find aic26_gazebo)/worlds/community.world"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="paused"       value="false"/>
    <arg name="gui"          value="true"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
    <arg name="verbose"      value="true"/>
  </include>

  <param name="/day_night" value="$(arg day_night)"/>
  <group if="$(eval arg('sky_time') != '')">
    <param name="/sky_time" value="$(arg sky_time)"/>
  </group>

  <param name="robot_description"
         command="$(find xacro)/xacro $(find aic26_description)/urdf/gazebo_car_union.xacro camera_image_width:=$(arg camera_image_width) camera_image_height:=$(arg camera_image_height) camera_image_rate:=$(arg camera_image_rate)"/>

  <node name="spawn_armbot" pkg="gazebo_ros" type="spawn_model"
        args="-param robot_description -urdf -model armbot -x 1.6 -y 1.7 -z 0 -Y 3.141592"
        output="screen"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>

  <node pkg="aic26_gazebo" type="traffic_controller.py" name="traffic_controller" output="screen">
    <param name="command_topic" value="/traffic_light/command"/>
    <param name="state_topic"   value="/traffic_light/state"/>
    <param name="rate_hz"       value="20.0"/>
    <param name="phase_offset"  value="10.0"/>
    <param name="startup_delay"  value="6.0"/>
    <param name="refresh_period" value="2.0"/>
    <rosparam param="durations">
      RED:    10
      GREEN:  15
      YELLOW:  3
    </rosparam>
  </node>

  <!-- With the slider off the node runs its one-shot path, which needs the
       day/night mode (or /sky_time) to know which sky to apply. -->
  <node pkg="aic26_gazebo" type="day_night.py" name="day_night_gui" output="screen"
        launch-prefix="bash -c 'sleep $(arg day_night_gui_delay); $0 $@'">
    <param name="gui" value="$(arg day_night_gui)"/>
    <param name="mode" value="$(arg day_night)"/>
  </node>

  <!-- camera_view.py: the stock image_view keeps its 320x240 GTK window when
       the display is X11 forwarded (see the docstring of the script) -->
  <include if="$(arg show_view)"
           file="$(find aic26_utils)/launch/camera_view.launch">
    <arg name="image" value="/camera/image_raw"/>
    <arg name="width" value="$(arg view_width)"/>
    <arg name="height" value="$(arg view_height)"/>
  </include>

</launch>
