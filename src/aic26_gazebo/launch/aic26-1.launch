<launch>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(find aic26_gazebo)/worlds/aic26-1.world"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="paused"       value="false"/>
    <arg name="gui"          value="true"/>
    <arg name="headless"     value="false"/>
    <arg name="debug"        value="false"/>
    <arg name="verbose"      value="true"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro $(find aic26_description)/urdf/gazebo_car_union.xacro"/>

  <node name="spawn_armbot" pkg="gazebo_ros" type="spawn_model"
        args="-param robot_description -urdf -model armbot -x 1.7 -y 1.7 -z 0 -Y 3.141592"
        output="screen"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>

  <node pkg="aic26_gazebo" type="traffic_controller.py" name="traffic_controller" output="screen">
    <param name="command_topic" value="/traffic_light/command"/>
    <param name="rate_hz"       value="20.0"/>
    <param name="phase_offset"  value="10.0"/>
    <rosparam param="durations">
      RED:    10
      GREEN:  8
      YELLOW:  2
    </rosparam>
  </node>

</launch>