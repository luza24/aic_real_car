<?xml version="1.0"?>
<launch>

  <arg name="model_path"
       default="$(find aic26_perception)/models/people_int8.onnx"/>
  <arg name="observe_time" default="0.8"/>
  <arg name="min_frames" default="2"/>
  <arg name="protocol_topic" default="/perception/people/protocol"/>
  <arg name="node_delay" default="0.0"/>

  <node name="people_detector" pkg="aic26_perception"
        type="people_detector.py" output="screen"
        launch-prefix="bash -c 'sleep $(arg node_delay); $0 $@'">
    <param name="model_path"   value="$(arg model_path)"/>
    <param name="image_in"     value="/camera/image_raw"/>
    <param name="result_topic" value="/perception/result"/>
    <param name="image_topic"  value="/perception/people/image"/>
    <param name="detect_topic" value="/perception/detect"/>
    <param name="input_size"   value="640"/>
    <param name="conf"         value="0.5"/>
    <param name="nms"          value="0.45"/>
    <param name="max_rate"     value="5.0"/>
    <param name="observe_time" value="$(arg observe_time)" type="double"/>
    <param name="min_frames"   value="$(arg min_frames)" type="int"/>
    <param name="protocol_topic" value="$(arg protocol_topic)"/>
  </node>

</launch>
