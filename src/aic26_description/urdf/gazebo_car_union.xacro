<?xml version="1.0"?>

<robot name="armbot" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:include filename="gazebo_head.xacro"/>
  <xacro:include filename="gazebo_car.xacro"/>
  <xacro:include filename="gazebo_laser.xacro"/>
  <xacro:include filename="gazebo_camera.xacro"/>
  <xacro:include filename="gazebo_light.xacro"/>

  <!-- The competition chassis is omnidirectional: the STM32 command frame
       carries vx, vy and wz, and the navigation stack uses a holonomic TEB
       configuration. libgazebo_ros_skid_steer_drive only reads linear.x and
       angular.z, so it silently drops every strafing command. PlanarMove
       executes the full twist (including linear.y) and still provides the
       same /cmd_vel, /odom and odom -> base_footprint interface. -->
  <gazebo>
    <plugin name="mobile_base_controller" filename="libgazebo_ros_planar_move.so">
      <commandTopic>/cmd_vel</commandTopic>
      <odometryTopic>/odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <odometryRate>30.0</odometryRate>
      <!-- Stop the model if /cmd_vel disappears (move_base crash, teleop
           release, ...). Without this the planar-move plugin keeps applying
           the last twist forever. -->
      <cmdTimeout>0.5</cmdTimeout>
    </plugin>
  </gazebo>

</robot>
