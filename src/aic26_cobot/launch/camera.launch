<?xml version="1.0"?>
<launch>

  <arg name="device" default="/dev/video0"/>
  <arg name="autodetect" default="true"/>
  <arg name="width" default="1280"/>
  <arg name="height" default="720"/>
  <arg name="fps" default="30"/>
  <arg name="view_width" default="640"/>
  <arg name="view_height" default="360"/>
  <arg name="view_fps" default="10"/>
  <arg name="view_quality" default="30"/>
  <arg name="always_on" default="false"/>
  <arg name="frame_id" default="camera"/>
  <arg name="node_delay" default="0.0"/>

  <node name="camera" pkg="aic26_cobot" type="camera_node.py"
        output="screen"
        launch-prefix="bash -c 'sleep $(arg node_delay); $0 $@'">
    <rosparam command="load"
              file="$(find aic26_cobot)/config/camera.yaml"/>
    <param name="device" value="$(arg device)"/>
    <param name="autodetect" value="$(arg autodetect)" type="bool"/>
    <param name="width" value="$(arg width)" type="int"/>
    <param name="height" value="$(arg height)" type="int"/>
    <param name="fps" value="$(arg fps)" type="int"/>
    <param name="view_width" value="$(arg view_width)" type="int"/>
    <param name="view_height" value="$(arg view_height)" type="int"/>
    <param name="view_fps" value="$(arg view_fps)" type="int"/>
    <param name="view_quality" value="$(arg view_quality)" type="int"/>
    <param name="always_on" value="$(arg always_on)" type="bool"/>
    <param name="frame_id" value="$(arg frame_id)"/>
  </node>

</launch>
