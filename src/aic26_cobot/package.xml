<?xml version="1.0"?>
<package format="2">
  <name>aic26_cobot</name>
  <version>0.1.0</version>
  <description>Hardware interfaces for the AIC26 real robot: chassis,
  lidar, camera and IMU drivers plus the matching launch files.</description>

  <maintainer email="govis@todo.todo">govis</maintainer>

  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>

  <!-- Runtime Python and helper packages. -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>python3-nose</test_depend>

  <export>

  </export>
</package>
