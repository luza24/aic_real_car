<?xml version="1.0"?>
<launch>


  <arg name="show" default="true"/>
  <arg name="image" default="/camera/image_raw"/>
  <arg name="transport" default="compressed"/>
  <arg name="width" default="640"/>
  <arg name="height" default="360"/>
  <arg name="window_name" default="camera"/>
  <arg name="rate" default="15.0"/>

  <arg name="save" default="true"/>
  <arg name="save_fps" default="0.0"/>
  <arg name="save_dir" default="$(find aic26_utils)/../../.datasets/capture"/>
  <arg name="filename" default="frame_{index:04d}.jpg"/>
  <arg name="label" default=""/>

  <node if="$(arg show)" name="camera_view" pkg="aic26_utils"
        type="camera_view.py" output="screen">
    <param name="image" value="$(arg image)"/>
    <param name="transport" value="$(arg transport)"/>
    <param name="width" value="$(arg width)"/>
    <param name="height" value="$(arg height)"/>
    <param name="window_name" value="$(arg window_name)"/>
    <param name="rate" value="$(arg rate)"/>
    <param name="save" value="$(arg save)"/>
    <param name="save_fps" value="$(arg save_fps)"/>
    <param name="save_dir" value="$(arg save_dir)"/>
    <param name="filename" value="$(arg filename)"/>
    <param name="label" value="$(arg label)"/>
  </node>

</launch>
