<launch>

  <arg name="world"          default="aic26-1"/>
  <arg name="day_night"      default="day"/>
  <!-- optional sky box time of day in hours [0..24]; overrides day_night -->
  <arg name="sky_time"       default=""/>
  <!-- launch the day/night sky time GUI (needs a display) -->
  <arg name="day_night_gui"  default="false"/>
  <arg name="map_file"       default="$(find aic26_slam)/maps/aic26-1.yaml"/>
  <arg name="use_navigation" default="true"/>
  <arg name="use_mission"    default="true"/>
  <arg name="use_perception" default="true"/>
  <arg name="use_rviz"       default="true"/>

  <include file="$(find aic26_gazebo)/launch/$(arg world).launch">
    <arg name="day_night" value="$(arg day_night)"/>
    <arg name="sky_time"  value="$(arg sky_time)"/>
  </include>

  <node if="$(arg day_night_gui)" pkg="aic26_gazebo" type="day_night.py"
        name="day_night_gui" output="screen" args="_gui:=true"/>

  <group if="$(arg use_navigation)">
    <include file="$(find aic26_navigation)/launch/navigation.launch">
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="use_rviz" value="$(arg use_rviz)"/>
    </include>
  </group>

  <group if="$(arg use_perception)">
    <include file="$(find aic26_perception)/launch/traffic_light.launch"/>
    <include file="$(find aic26_perception)/launch/people.launch"/>
    <include file="$(find aic26_perception)/launch/car.launch"/>
  </group>

  <group if="$(arg use_mission)">
    <include file="$(find aic26_decision)/launch/mission.launch"/>
  </group>

</launch>
