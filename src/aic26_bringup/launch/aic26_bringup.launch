<launch>

  <arg name="world"          default="aic26-1"/>
  <arg name="map_file"       default="$(find aic26_slam)/maps/aic26-1.yaml"/>
  <arg name="use_navigation" default="true"/>
  <arg name="use_mission"    default="true"/>
  <arg name="use_perception" default="true"/>
  <arg name="use_rviz"       default="true"/>

  <include file="$(find aic26_gazebo)/launch/$(arg world).launch"/>

  <group if="$(arg use_navigation)">
    <include file="$(find aic26_navigation)/launch/navigation.launch">
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="use_rviz" value="$(arg use_rviz)"/>
    </include>
  </group>

  <group if="$(arg use_perception)">
    <node name="perception_stub" pkg="aic26_perception"
          type="perception_stub.py" output="screen">
      <param name="use_truth" value="true"/>
    </node>
    <node name="ocr_stub" pkg="aic26_ocr"
          type="ocr_stub.py" output="screen"/>
  </group>

  <group if="$(arg use_mission)">
    <include file="$(find aic26_decision)/launch/mission.launch"/>
  </group>

</launch>
