<?xml version="1.0"?>
<launch>

  <!-- Loop capture: simulation + navigation + capture. Walks the
       route saving labeled screenshots until every stop reaches its "shots"
       target, advancing the sky box every cycle. -->

  <arg name="world"       default="world"/>
  <arg name="day_night"   default="day"/>
  <arg name="sky_time"    default=""/>
  <arg name="map_file"    default="$(find aic26_slam)/maps/world.yaml"/>
  <arg name="use_rviz"    default="false"/>
  <arg name="sky_step"    default="1.1"/>
  <arg name="until_done"  default="true"/>
  <arg name="show_view" default="true"/>
  <!-- start-up delays: let the simulation come up before the navigation stack,
       and the navigation stack before the task nodes -->
  <arg name="nav_delay"   default="8.0"/>
  <arg name="task_delay"  default="10.0"/>

  <include file="$(find aic26_gazebo)/launch/$(arg world).launch">
    <arg name="day_night" value="$(arg day_night)"/>
    <arg name="sky_time"  value="$(arg sky_time)"/>
    <arg name="show_view" value="$(arg show_view)"/>
  </include>

  <include file="$(find aic26_navigation)/launch/navigation.launch">
    <arg name="map_file"   value="$(arg map_file)"/>
    <arg name="use_rviz"   value="$(arg use_rviz)"/>
    <arg name="node_delay" value="$(arg nav_delay)"/>
  </include>

  <include file="$(find aic26_decision)/launch/capture.launch">
    <arg name="sky_step"   value="$(arg sky_step)"/>
    <arg name="until_done" value="$(arg until_done)"/>
    <arg name="node_delay" value="$(arg task_delay)"/>
  </include>

</launch>
