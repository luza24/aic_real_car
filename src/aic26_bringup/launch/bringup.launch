<?xml version="1.0"?>
<launch>

  <arg name="mode" default="mission"/>
  <arg name="backend" default="sim"/>

  <arg name="sim" default="sim"/>
  <arg name="day_night" default="day"/>
  <arg name="sky_time" default=""/>
  <arg name="show_view" default="true"/>

  <arg name="map_name"
       default="$(eval 'world_real.yaml' if arg('backend') == 'real' else 'world_sim.yaml')"/>
  <arg name="map_file" default="$(find aic26_slam)/maps/$(arg map_name)"/>
  <arg name="use_rviz" default="true"/>
  <arg name="nav_delay" default="15.0"/>
  <arg name="task_delay" default="20.0"/>

  <arg name="set_initial_pose" default="true"/>
  <arg name="initial_pose_x" default="1.6"/>
  <arg name="initial_pose_y" default="1.7"/>
  <arg name="initial_pose_a" default="3.141592"/>

  <arg name="use_imu_yaw" default="true"/>
  <arg name="chassis_port" default="/dev/carserial"/>
  <arg name="imu_port" default="/dev/imu"/>
  <arg name="lidar_port" default="/dev/lslidar"/>
  <arg name="camera_device" default="/dev/video0"/>
  <arg name="teleop" default="false"/>
  <arg name="disable_strafe" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="light_fallback"
       default="$(eval 'traffic_light' if arg('backend') == 'real' else '')"/>

  <group if="$(eval arg('mode') == 'mission' or arg('mode') == 'real')">
    <include file="$(find aic26_bringup)/launch/mission.launch">
      <arg name="disable_strafe" value="$(arg disable_strafe)"/>
      <arg name="backend" value="$(arg backend)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="day_night" value="$(arg day_night)"/>
      <arg name="sky_time" value="$(arg sky_time)"/>
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="use_rviz" value="$(arg use_rviz)"/>
      <arg name="show_view" value="$(arg show_view)"/>
      <arg name="use_imu_yaw" value="$(arg use_imu_yaw)"/>
      <arg name="chassis_port" value="$(arg chassis_port)"/>
      <arg name="imu_port" value="$(arg imu_port)"/>
      <arg name="lidar_port" value="$(arg lidar_port)"/>
      <arg name="camera_device" value="$(arg camera_device)"/>
      <arg name="teleop" value="$(arg teleop)"/>
      <arg name="gui" value="$(arg gui)"/>
      <arg name="light_fallback" value="$(arg light_fallback)"/>
      <arg name="nav_delay" value="$(arg nav_delay)"/>
      <arg name="task_delay" value="$(arg task_delay)"/>
      <arg name="set_initial_pose" value="$(arg set_initial_pose)"/>
      <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
      <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
      <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
    </include>
  </group>

  <group if="$(eval arg('mode') == 'demo')">
    <include file="$(find aic26_bringup)/launch/demo.launch">
      <arg name="disable_strafe" value="$(arg disable_strafe)"/>
      <arg name="backend" value="$(arg backend)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="day_night" value="$(arg day_night)"/>
      <arg name="sky_time" value="$(arg sky_time)"/>
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="use_rviz" value="$(arg use_rviz)"/>
      <arg name="show_view" value="$(arg show_view)"/>
      <arg name="use_imu_yaw" value="$(arg use_imu_yaw)"/>
      <arg name="chassis_port" value="$(arg chassis_port)"/>
      <arg name="imu_port" value="$(arg imu_port)"/>
      <arg name="lidar_port" value="$(arg lidar_port)"/>
      <arg name="camera_device" value="$(arg camera_device)"/>
      <arg name="teleop" value="$(arg teleop)"/>
      <arg name="nav_delay" value="$(arg nav_delay)"/>
      <arg name="task_delay" value="$(arg task_delay)"/>
      <arg name="set_initial_pose" value="$(arg set_initial_pose)"/>
      <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
      <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
      <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
    </include>
  </group>
  <group if="$(eval arg('mode') == 'capture')">
    <include file="$(find aic26_bringup)/launch/capture.launch">
      <arg name="disable_strafe" value="$(arg disable_strafe)"/>
      <arg name="backend" value="$(arg backend)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="day_night" value="$(arg day_night)"/>
      <arg name="sky_time" value="$(arg sky_time)"/>
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="use_rviz" value="$(arg use_rviz)"/>
      <arg name="show_view" value="$(arg show_view)"/>
      <arg name="use_imu_yaw" value="$(arg use_imu_yaw)"/>
      <arg name="chassis_port" value="$(arg chassis_port)"/>
      <arg name="imu_port" value="$(arg imu_port)"/>
      <arg name="lidar_port" value="$(arg lidar_port)"/>
      <arg name="camera_device" value="$(arg camera_device)"/>
      <arg name="teleop" value="$(arg teleop)"/>
      <arg name="nav_delay" value="$(arg nav_delay)"/>
      <arg name="task_delay" value="$(arg task_delay)"/>
      <arg name="set_initial_pose" value="$(arg set_initial_pose)"/>
      <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
      <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
      <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
    </include>
  </group>

  <group if="$(eval arg('mode') == 'waypoints')">
    <include file="$(find aic26_bringup)/launch/waypoints.launch">
      <arg name="disable_strafe" value="$(arg disable_strafe)"/>
      <arg name="backend" value="$(arg backend)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="day_night" value="$(arg day_night)"/>
      <arg name="sky_time" value="$(arg sky_time)"/>
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="use_rviz" value="$(arg use_rviz)"/>
      <arg name="show_view" value="$(arg show_view)"/>
      <arg name="use_imu_yaw" value="$(arg use_imu_yaw)"/>
      <arg name="chassis_port" value="$(arg chassis_port)"/>
      <arg name="imu_port" value="$(arg imu_port)"/>
      <arg name="lidar_port" value="$(arg lidar_port)"/>
      <arg name="camera_device" value="$(arg camera_device)"/>
      <arg name="teleop" value="$(arg teleop)"/>
      <arg name="nav_delay" value="$(arg nav_delay)"/>
      <arg name="task_delay" value="$(arg task_delay)"/>
      <arg name="set_initial_pose" value="$(arg set_initial_pose)"/>
      <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
      <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
      <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
    </include>
  </group>

  <group if="$(eval arg('mode') == 'localise')">
    <include file="$(find aic26_bringup)/launch/localise.launch">
      <arg name="disable_strafe" value="$(arg disable_strafe)"/>
      <arg name="backend" value="$(arg backend)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="day_night" value="$(arg day_night)"/>
      <arg name="sky_time" value="$(arg sky_time)"/>
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="use_rviz" value="$(arg use_rviz)"/>
      <arg name="show_view" value="$(arg show_view)"/>
      <arg name="use_imu_yaw" value="$(arg use_imu_yaw)"/>
      <arg name="chassis_port" value="$(arg chassis_port)"/>
      <arg name="imu_port" value="$(arg imu_port)"/>
      <arg name="lidar_port" value="$(arg lidar_port)"/>
      <arg name="camera_device" value="$(arg camera_device)"/>
      <arg name="teleop" value="$(arg teleop)"/>
      <arg name="nav_delay" value="$(arg nav_delay)"/>
      <arg name="set_initial_pose" value="$(arg set_initial_pose)"/>
      <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
      <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
      <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
    </include>
  </group>

  <group if="$(eval arg('mode') == 'mapping')">
    <include file="$(find aic26_bringup)/launch/mapping.launch">
      <arg name="backend" value="$(arg backend)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="day_night" value="$(arg day_night)"/>
      <arg name="sky_time" value="$(arg sky_time)"/>
      <arg name="show_view" value="$(arg show_view)"/>
      <arg name="use_rviz" value="$(arg use_rviz)"/>
      <arg name="use_imu_yaw" value="$(arg use_imu_yaw)"/>
      <arg name="chassis_port" value="$(arg chassis_port)"/>
      <arg name="imu_port" value="$(arg imu_port)"/>
      <arg name="lidar_port" value="$(arg lidar_port)"/>
      <arg name="camera_device" value="$(arg camera_device)"/>
      <arg name="nav_delay" value="$(arg nav_delay)"/>
      <arg name="start_x" value="$(arg initial_pose_x)"/>
      <arg name="start_y" value="$(arg initial_pose_y)"/>
      <arg name="start_yaw" value="$(arg initial_pose_a)"/>
    </include>
  </group>

  <group if="$(eval arg('mode') == 'view_map')">
    <include file="$(find aic26_bringup)/launch/view_map.launch">
      <arg name="backend" value="$(arg backend)"/>
      <arg name="sim" value="$(arg sim)"/>
      <arg name="day_night" value="$(arg day_night)"/>
      <arg name="sky_time" value="$(arg sky_time)"/>
      <arg name="show_view" value="$(arg show_view)"/>
      <arg name="map_file" value="$(arg map_file)"/>
      <arg name="use_rviz" value="$(arg use_rviz)"/>
      <arg name="start_x" value="$(arg initial_pose_x)"/>
      <arg name="start_y" value="$(arg initial_pose_y)"/>
      <arg name="start_yaw" value="$(arg initial_pose_a)"/>
      <arg name="use_imu_yaw" value="$(arg use_imu_yaw)"/>
      <arg name="chassis_port" value="$(arg chassis_port)"/>
      <arg name="imu_port" value="$(arg imu_port)"/>
      <arg name="lidar_port" value="$(arg lidar_port)"/>
      <arg name="camera_device" value="$(arg camera_device)"/>
    </include>
  </group>

</launch>
