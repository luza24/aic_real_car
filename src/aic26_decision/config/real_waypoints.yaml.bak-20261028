# Real-robot waypoint set, used when mission.launch / waypoints.launch /
# demo.launch / capture.launch run with backend:=real.
#
# Field-measured poses in the AMCL map frame (metres, radians). Keep the names
# identical to sim_waypoints.yaml: real_tasks.yaml and
# real_screenshot_cycle.yaml refer to them by name.
#
# The values below currently mirror the simulation scene. Measure each pose on
# the real field (RViz "Publish Point" on the map) and update x / y / yaw here;
# no launch or code change is needed afterwards.

waypoints:
  - name: "traffic_light_1"
    x: 0.6
    y: 1.60
    yaw: 3.141592
    dwell: 0.0
  - name: "station_1"
    x: -1.0
    y: 1.63
    yaw: 3.141592
    dwell: 2.0
  - name: "station_2"
    x: -1.65
    y: 1.1
    yaw: 4.712388
    dwell: 2.0
  - name: "station_3"
    x: -0.5
    y: 0.50
    yaw: 0.000000
    dwell: 2.0
  - name: "traffic_light_2"
    x: -0.05
    y: -0.1
    yaw: 4.712388
    dwell: 0.0
  - name: "car_1"
    x: 1.2
