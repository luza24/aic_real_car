<?xml version="1.0"?>
<launch>

  <arg name="map_file" default="$(find aic26_slam)/maps/world.yaml"/>
  <arg name="use_rviz" default="true"/>
  <!-- start-up delay (s) applied to every node in this file, so the caller can
       wait for the simulation to come up before the navigation stack starts.
       0 disables the wait. -->
  <arg name="node_delay" default="0.0"/>
  <!-- AMCL inputs. The caller can override the initial pose; the mode launch
       files default it to the map start pose for both backends. -->
  <arg name="set_initial_pose" default="true"/>
  <arg name="initial_pose_x" default="1.6"/>
  <arg name="initial_pose_y" default="1.7"/>
  <arg name="initial_pose_a" default="3.141592"/>
  <arg name="laser_min_range" default="0.1"/>
  <arg name="laser_max_range" default="12.0"/>
  <!-- Set false to run a controller that publishes
       /cmd_vel itself (e.g. direct.launch). -->
  <arg name="use_move_base" default="true"/>

  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)"
        launch-prefix="bash -c 'sleep $(arg node_delay); $0 $@'"/>

  <node name="amcl" pkg="amcl" type="amcl" output="screen"
        launch-prefix="bash -c 'sleep $(arg node_delay); $0 $@'">
    <rosparam file="$(find aic26_navigation)/config/amcl_params.yaml" command="load"/>
    <param name="set_initial_pose" value="$(arg set_initial_pose)" type="bool"/>
    <param name="initial_pose_x" value="$(arg initial_pose_x)" type="double"/>
    <param name="initial_pose_y" value="$(arg initial_pose_y)" type="double"/>
    <param name="initial_pose_a" value="$(arg initial_pose_a)" type="double"/>
    <param name="laser_min_range" value="$(arg laser_min_range)" type="double"/>
    <param name="laser_max_range" value="$(arg laser_max_range)" type="double"/>
  </node>

  <group if="$(arg use_move_base)">
    <node name="move_base" pkg="move_base" type="move_base" output="screen"
          launch-prefix="bash -c 'sleep $(arg node_delay); $0 $@'">
      <rosparam file="$(find aic26_navigation)/config/costmap_common_params.yaml"
                command="load" ns="global_costmap"/>
      <rosparam file="$(find aic26_navigation)/config/costmap_common_params.yaml"
                command="load" ns="local_costmap"/>
      <rosparam file="$(find aic26_navigation)/config/global_costmap_params.yaml"
                command="load"/>
      <rosparam file="$(find aic26_navigation)/config/local_costmap_params.yaml"
                command="load"/>
      <!-- global_planner_params.yaml already has a GlobalPlanner root key;
           adding ns="GlobalPlanner" here would double the namespace. -->
      <rosparam file="$(find aic26_navigation)/config/global_planner_params.yaml"
                command="load"/>
      <rosparam file="$(find aic26_navigation)/config/local_planner_params.yaml"
                command="load"/>

      <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
      <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>
      <param name="controller_frequency" value="10.0"/>
      <param name="planner_frequency"    value="1.0"/>
      <param name="planner_patience"     value="5.0"/>
      <param name="controller_patience"  value="15.0"/>
      <param name="oscillation_timeout"  value="6.0"/>
      <param name="oscillation_distance" value="0.1"/>
      <param name="clearing_rotation_allowed" value="true"/>
      <param name="recovery_behavior_enabled" value="true"/>
    </node>
  </group>

  <node if="$(arg use_rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find aic26_navigation)/rviz/navigation.rviz"
        launch-prefix="bash -c 'sleep $(arg node_delay); $0 $@'"/>

</launch>
