Panels:
  - Class: rviz/Displays
    Name: Displays

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true

    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map

    - Class: rviz/Map
      Name: GlobalCostmap
      Enabled: true
      Topic: /move_base/global_costmap/costmap

    - Class: rviz/Map
      Name: LocalCostmap
      Enabled: true
      Topic: /move_base/local_costmap/costmap

    - Class: rviz/Path
      Name: GlobalPlan
      Enabled: true
      Topic: /move_base/GlobalPlanner/plan

    - Class: rviz/Path
      Name: LocalPlan
      Enabled: true
      Topic: /move_base/TebLocalPlannerROS/local_plan

    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan

    - Class: rviz/PoseArray
      Name: Particlecloud
      Enabled: true
      Topic: /particlecloud
      Shape: Arrow (3D)
      Alpha: 0.1

    - Class: rviz/TF
      Name: TF
      Enabled: true

    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description

  Global Options:
    Fixed Frame: map
    # No GPU on the car: RViz renders with llvmpipe and each frame is shipped
    # to VcXsrv over WiFi. 10 FPS is enough to watch the nav stack and cuts
    # the X11 pixel traffic compared with the 30 FPS default.
    Frame Rate: 10

  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true

Window Geometry:
  Height: 800
  Width: 1200
  X: 300
  Y: 200
