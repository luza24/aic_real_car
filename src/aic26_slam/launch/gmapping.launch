<launch>

  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">

    <param name="base_frame"   value="base_footprint"/>
    <param name="odom_frame"   value="odom"/>
    <param name="map_frame"    value="map"/>
    <param name="scan_topic"   value="/scan"/>

    <param name="particles"    value="80"/>
    <param name="delta"        value="0.05"/>

    <param name="xmin" value="-6"/>
    <param name="ymin" value="-6"/>
    <param name="xmax" value="6"/>
    <param name="ymax" value="6"/>

    <param name="linearUpdate"  value="0.10"/>
    <param name="angularUpdate" value="0.10"/>
    <param name="temporalUpdate" value="1.0"/>
    <param name="resampleThreshold" value="0.5"/>

  </node>

  <node pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" 
        name="teleop" output="screen"
        launch-prefix="xterm -e">
    <param name="speed" value="0.1"/>
    <param name="turn"  value="0.5"/>
  </node>

  <node pkg="image_view" type="image_view"
        name="image_view" output="screen">
    <remap from="image" to="/camera/image_raw"/>
    <param name="filename" value="/home/govis/aic26_datasets/screenshots/snap_"/>
  </node>
  
</launch>