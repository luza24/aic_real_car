Panels:
  - Class: rviz/Displays
    Name: Displays

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true

    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan

    - Class: rviz/Odometry
      Name: Odometry
      Enabled: true
      Topic: /odom
      Covariance:
        Value: false

    - Class: rviz/TF
      Name: TF
      Enabled: true

    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map

    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description

  Global Options:
    Fixed Frame: map

  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true

Window Geometry:
  Height: 800
  Width: 1200
  X: 300
  Y: 200
